CREATE TABLE ref (
  id           INTEGER PRIMARY KEY,
  from_source  INTEGER NOT NULL REFERENCES source(id),
  from_symbol  INTEGER REFERENCES symbol(id),
  to_name      TEXT NOT NULL,               -- as written in the code
  to_source    INTEGER REFERENCES source(id),
  to_symbol    INTEGER REFERENCES symbol(id),
